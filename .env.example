# Public browser config for the Firebase web app.
# Vite exposes VITE_* variables to the client, so only put browser-safe values here.

VITE_FB_WEB_KEY=your_firebase_web_key
VITE_FB_APP_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_SENDER_ID=your_messaging_sender_id
VITE_FB_APP_ID=your_firebase_app_id
VITE_FB_MEASUREMENT_ID=your_measurement_id

# Real secrets belong in a server-only environment, never behind a VITE_ prefix.
# Examples:
# FIREBASE_ADMIN_PRIVATE_KEY=
# JWT_SECRET=
